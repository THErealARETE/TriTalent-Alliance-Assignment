    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
