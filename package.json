{
  "name": "tritalent-playwright",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "author": "",
  "license": "ISC",
  "description": "Playwright + TypeScript take-home: saucedemo UI test and Restful-booker API test",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
