# Copy to .env and fill in. .env is gitignored; CI provides these as secrets instead.
# The values below are the public demo credentials published by each application.

# saucedemo (UI)
SAUCE_BASE_URL=https://www.saucedemo.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Restful-booker (API). The admin account is used to delete test data after each test.
BOOKER_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
